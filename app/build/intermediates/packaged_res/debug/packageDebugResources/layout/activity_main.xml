<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Rayan Rahmoun" android:textSize="24sp" android:textStyle="bold"
        android:paddingBottom="12dp"/>
    <TextView android:id="@+id/chatText" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:text="مرحبا! أنا Rayan Rahmoun 👋&#10;&#10;اكتب رسالتك بالأسفل."
        android:textSize="17sp" android:padding="12dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <EditText android:id="@+id/messageInput" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:hint="اكتب رسالة..." android:singleLine="true"/>
        <Button android:id="@+id/sendButton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="إرسال"/>
    </LinearLayout>
</LinearLayout>
